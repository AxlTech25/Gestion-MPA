# Copie a .env.production antes de compilar, o defina en el panel de Vercel.
#
# Mismo host (Apache clásico): ruta relativa
# VITE_API_BASE_URL=/backend/api/v2
#
# Vercel + Railway (dominios distintos): URL absoluta pública del API
VITE_API_BASE_URL=https://TU-SERVICIO-API.up.railway.app

# Ruta base del frontend (use / si el sitio está en la raíz del dominio)
VITE_BASE_PATH=/
